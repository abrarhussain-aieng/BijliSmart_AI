# Database connection string. Leave empty to use local SQLite (bijliwise.db).
# For PostgreSQL (e.g. Render Postgres) copy the "Internal Database URL" from the Render dashboard.
DATABASE_URL=

# Folder where ChromaDB stores the knowledge-base vectors. Leave empty to use ./data/chroma
CHROMA_PERSIST_DIRECTORY=

MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=
MISTRAL_EMBED_MODEL=
MISTRAL_OCR_MODEL=